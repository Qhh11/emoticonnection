# EmotiConnect Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=EmotiConnect
DEBUG=True

# Database
DATABASE_URL=sqlite:///./emoticonnect.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/emoticonnect

# LLM API Configuration
# TODO: Add your LLM provider credentials
LLM_API_KEY=your-api-key-here
LLM_API_ENDPOINT=https://api.openai.com/v1
# Or for Anthropic: LLM_API_ENDPOINT=https://api.anthropic.com/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
